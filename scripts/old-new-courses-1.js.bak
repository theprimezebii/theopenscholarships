// Remove the malformed "Successful Negotiation..." entry if present (the one with the placeholder description)
const cleanedCourses = newCourses.filter(course => {
  const isMalformed = course.description && course.description.includes("Already listed as #3");
  if (isMalformed) console.warn(`⚠️ Skipping malformed course: ${course.title}`);
  return !isMalformed;
});

async function seed() {
  try {
    await mongoose.connect(MONGODB_URI);
    console.log('✅ Connected to MongoDB');

    let addedCount = 0;
    let skippedCount = 0;

    for (const courseData of cleanedCourses) {
      // Generate slug from title
      const slug = slugify(courseData.title);

      // Check if a course with this slug already exists
      const existing = await Course.findOne({ slug });
      if (existing) {
        console.log(`⏭️ Skipping existing course: ${courseData.title} (slug: ${slug})`);
        skippedCount++;
        continue;
      }

      // Add slug to the document
      const courseToInsert = { ...courseData, slug };
      await Course.create(courseToInsert);
      console.log(`✅ Added new course: ${courseData.title}`);
      addedCount++;
    }

    console.log(`\n🎉 Done! Added ${addedCount} new courses, skipped ${skippedCount} existing ones.`);
    process.exit(0);
  } catch (error) {
    console.error('❌ Error seeding courses:', error);
    process.exit(1);
  }
}

seed();